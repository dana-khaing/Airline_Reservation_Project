<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex flex-col items-center justify-center gap-8 py-16 text-center">
    <div>
      <h1 class="text-4xl font-bold">LET'S FLY TOGETHER !!</h1>
      <h2 class="mt-2 text-xl font-normal">Explore the world with Albert Airline</h2>
    </div>
    <.button href="/search" variant="primary" class="px-8 py-4 text-lg">
      BOOK A FLIGHT
    </.button>
  </div>
</Layouts.app>
