<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="flex flex-col items-center justify-center gap-8 py-16 text-center">
    <div>
      <h1 class="text-4xl font-bold">LET'S FLY TOGETHER !!</h1>
      <h3 class="mt-2 text-xl">Explore the world with Albert Airline</h3>
    </div>
    <.link
      href="/search"
      class="rounded-lg bg-[#369de9]/90 px-8 py-4 text-lg font-semibold text-white hover:opacity-90"
    >
      BOOK A FLIGHT
    </.link>
  </div>
</Layouts.app>
